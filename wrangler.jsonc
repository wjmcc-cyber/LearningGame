{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "learning-game",
  "compatibility_date": "2026-03-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "learning-game"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learning-game-db",
      "database_id": "303b910f-cbe7-4c61-bfed-df704528e9be"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "learning-game-opennext-cache"
    },
    {
      "binding": "STUDY_DOCUMENTS_BUCKET",
      "bucket_name": "learning-game-documents"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}